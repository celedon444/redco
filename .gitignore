.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo

# Prisma
prisma/migrations/**/migration_lock.toml

# Docker
.docker/

# Coverage
coverage/
.nyc_output/

# Playwright
playwright-report/
test-results/

# Misc
*.pem
.cache/
