# ============================================================
# REDCO — Variables de entorno del Backend (plantilla)
# ============================================================
# Copia este archivo como .env en el directorio backend/:
#   cp backend/.env.example backend/.env
#
# Este archivo es para desarrollo local (sin Docker).
# Cuando uses Docker Compose, las variables se pasan
# directamente desde docker-compose.yml.
#
# NO versiones el archivo .env — está en .gitignore
# ============================================================

# ----------------------------------------------------------
# Base de datos (desarrollo local — PostgreSQL via Docker)
# El puerto 5432 es el expuesto por el servicio postgres
# en docker-compose.yml
# ----------------------------------------------------------
DATABASE_URL="postgresql://redco:redco_secret@localhost:5432/redco_db?schema=public"

# ----------------------------------------------------------
# Aplicación
# ----------------------------------------------------------
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------
# URL del frontend (para configuración de CORS)
# ----------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------
# JWT — Se usará en un bloque posterior (autenticación)
# ----------------------------------------------------------
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES_IN=7d
