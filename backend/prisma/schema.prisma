// REDCO — Prisma Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis()]
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CITIZEN
  EMERGENCY_OPERATOR
  RESPONSE_PERSONNEL
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IncidentType {
  EARTHQUAKE
  FLOOD
  LANDSLIDE
  WILDFIRE
  STORM
  OTHER
}

enum IncidentSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DRAFT
  ACTIVE
  CONTROLLED
  CLOSED
}

enum ReportType {
  PERSON
  INJURY
  INFRASTRUCTURE
  ROAD
  HOSPITAL
  FIRE
  FLOOD
  NEED
  OTHER
}

enum ReportStatus {
  RECEIVED
  UNDER_REVIEW
  VALIDATED
  REJECTED
  ARCHIVED
}

enum PersonCaseStatus {
  MISSING
  UNDER_VERIFICATION
  LOCATED
  DECEASED_CONFIRMED
  CLOSED
}

enum InfrastructureType {
  ROAD
  BRIDGE
  BUILDING
  HOSPITAL
  SCHOOL
  OTHER
}

enum InfrastructureStatus {
  REPORTED
  ASSESSED
  AFFECTED
  RECOVERED
}

enum HumanitarianNeedType {
  WATER
  FOOD
  MEDICINE
  SHELTER
  CLOTHING
  MEDICAL_ATTENTION
  OTHER
}

enum HumanitarianNeedPriority {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum HumanitarianNeedStatus {
  REPORTED
  VALIDATED
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum EvidenceType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum OrganizationType {
  FIRE_DEPARTMENT
  CIVIL_DEFENSE
  RED_CROSS
  POLICE
  TERRITORIAL_ENTITY
  HEALTH
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum ResponseUnitType {
  VEHICLE
  BRIGADE
  MEDICAL_UNIT
  RESCUE_UNIT
  OTHER
}

enum ResponseUnitStatus {
  AVAILABLE
  ASSIGNED
  UNAVAILABLE
  INACTIVE
}

enum IncidentAssignmentStatus {
  ASSIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AffectationLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

// ============================================================
// ENTITIES
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole
  status       UserStatus
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reports         Report[]
  incidents       Incident[]
  auditLogs       AuditLog[]
  evidences       Evidence[] @relation("EvidenceUploadedBy")
  reviewedReports Report[]   @relation("ReportReviewedBy")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  type        OrganizationType
  description String?
  phone       String?
  email       String?
  website     String?
  status      OrganizationStatus
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  location    Unsupported("geometry(Point, 4326)")?

  responseUnits ResponseUnit[]
}

model ResponseUnit {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  name           String
  type           ResponseUnitType
  status         ResponseUnitStatus
  phone          String?
  location       Unsupported("geometry(Point, 4326)")?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id])
  assignments    IncidentAssignment[]
}

model Incident {
  id           String           @id @default(uuid()) @db.Uuid
  title        String
  description  String
  type         IncidentType
  severity     IncidentSeverity
  status       IncidentStatus
  magnitude    Decimal?         @db.Decimal(4, 2)
  location     Unsupported("geometry(Point, 4326)")?
  startedAt    DateTime
  controlledAt DateTime?
  closedAt     DateTime?
  createdById  String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy         User               @relation(fields: [createdById], references: [id])
  reports           Report[]
  personCases       PersonCase[]
  infrastructures   Infrastructure[]
  humanitarianNeeds HumanitarianNeed[]
  assignments       IncidentAssignment[]
  affectationZones  AffectationZone[]

  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([startedAt])
}

model IncidentAssignment {
  id             String                   @id @default(uuid()) @db.Uuid
  incidentId     String                   @db.Uuid
  responseUnitId String                   @db.Uuid
  role           String?
  status         IncidentAssignmentStatus
  assignedAt     DateTime                 @default(now())
  endedAt        DateTime?
  createdAt      DateTime                 @default(now())

  incident       Incident                 @relation(fields: [incidentId], references: [id])
  responseUnit   ResponseUnit             @relation(fields: [responseUnitId], references: [id])

  @@unique([incidentId, responseUnitId])
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  incidentId   String?      @db.Uuid
  userId       String?      @db.Uuid
  type         ReportType
  title        String
  description  String
  location     Unsupported("geometry(Point, 4326)")?
  status       ReportStatus
  reportedAt   DateTime     @default(now())
  reviewedAt   DateTime?
  reviewedById String?      @db.Uuid
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  incident     Incident?    @relation(fields: [incidentId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  reviewedBy   User?        @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  evidences    Evidence[]

  @@index([incidentId])
  @@index([userId])
  @@index([status])
  @@index([reportedAt])
}

model Person {
  id                   String     @id @default(uuid()) @db.Uuid
  firstName            String
  lastName             String
  identificationType   String?
  identificationNumber String?
  dateOfBirth          DateTime?
  gender               String?
  phone                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  personCases          PersonCase[]
}

model PersonCase {
  id                String           @id @default(uuid()) @db.Uuid
  personId          String           @db.Uuid
  incidentId        String           @db.Uuid
  status            PersonCaseStatus
  description       String?
  lastKnownLocation Unsupported("geometry(Point, 4326)")?
  reportedAt        DateTime         @default(now())
  verifiedAt        DateTime?
  verifiedById      String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  person            Person           @relation(fields: [personId], references: [id])
  incident          Incident         @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([personId])
  @@index([status])
}

model Infrastructure {
  id           String               @id @default(uuid()) @db.Uuid
  incidentId   String               @db.Uuid
  type         InfrastructureType
  name         String
  description  String?
  status       InfrastructureStatus
  location     Unsupported("geometry(Point, 4326)")?
  reportedAt   DateTime             @default(now())
  assessedAt   DateTime?
  recoveredAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  incident     Incident             @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([status])
}

model HumanitarianNeed {
  id           String                   @id @default(uuid()) @db.Uuid
  incidentId   String                   @db.Uuid
  type         HumanitarianNeedType
  description  String?
  quantity     Int?
  unit         String?
  location     Unsupported("geometry(Point, 4326)")?
  priority     HumanitarianNeedPriority
  status       HumanitarianNeedStatus
  reportedAt   DateTime                 @default(now())
  fulfilledAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  incident     Incident                 @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([status])
  @@index([priority])
}

model Evidence {
  id           String       @id @default(uuid()) @db.Uuid
  reportId     String       @db.Uuid
  type         EvidenceType
  fileName     String
  mimeType     String
  storageKey   String
  size         Int
  uploadedAt   DateTime     @default(now())
  uploadedById String?      @db.Uuid

  report       Report       @relation(fields: [reportId], references: [id])
  uploadedBy   User?        @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

// ============================================================
// MAPA DE AFECTACIÓN (terremotos)
// ============================================================

model AffectationZone {
  id                String          @id @default(uuid()) @db.Uuid
  incidentId        String          @db.Uuid
  name              String
  level             AffectationLevel
  description       String?
  estimatedAffected Int?
  location          Unsupported("geometry(Polygon, 4326)")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  incident          Incident        @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([level])
}
