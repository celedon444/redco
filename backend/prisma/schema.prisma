// REDCO — Prisma Schema
// TODO: Definir el modelo de datos completo en la siguiente fase.
// Por ahora solo se configura el datasource y el generador.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

